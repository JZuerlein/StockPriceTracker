<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <UserSecretsId>aspnet-StockPriceTracker-a3160ad3-9c76-4d08-93e7-180c5d1c0fc0</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" NoWarn="NU1605" />
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" NoWarn="NU1605" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <!--
          Pin Microsoft.OpenApi above the vulnerable transitive 2.0.0 (GHSA-v5pm-xwqc-g5wc,
          patched in 2.7.5+). Must stay on the 2.x line: Microsoft.AspNetCore.OpenApi 10.0.10's
          XML-comment source generator assigns IOpenApiMediaType.Example, which is read-only in
          3.x, so 3.x fails to compile (CS0200).
        -->
        <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    </ItemGroup>

</Project>
